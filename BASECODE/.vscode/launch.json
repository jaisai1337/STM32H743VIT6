{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug (J-Link, STM32H743VI)",
      "type": "cortex-debug",
      "request": "launch",
      "servertype": "jlink",
      "device": "STM32H743VI",
      "interface": "swd",
      "executable": "${workspaceFolder}/build/BASECODE.elf",
      "runToEntryPoint": "main",
      "svdFile": "${workspaceFolder}/STM32H743.svd",
      "postRestartCommands": ["monitor reset"],
      "cwd": "${workspaceFolder}",
      "showDevDebugOutput": "raw",
      "cpu": "cortex-m7"
    }
  ]
}